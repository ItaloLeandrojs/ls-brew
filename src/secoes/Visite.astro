---
import { CONTATO } from "../dados/contato.js";
import { WHATSAPP } from "../config.js";
import { linkWhatsApp } from "../dominio/whatsapp.js";
import simbolo from "../assets/logo/ls-brew-simbolo-fundo-claro.svg?raw";
// As duas metades do grão do logo, para o pino do mapa.
const metades = [...simbolo.matchAll(/<path d="(M[^"]+Z)" fill="#[0-9A-Fa-f]{6}"\/>/g)].map((m) => m[1]);
if (metades.length !== 2) throw new Error(`Visite: esperava 2 metades do grão no símbolo, achei ${metades.length}`);
---
<section id="visite" class="secao visite">
  <div class="miolo visite-grade">
    <div data-revelar>
      <p class="rotulo">Visite a gente</p>
      <h2>Passa aqui pra um café</h2>
      <p class="sub">{CONTATO.endereco} · {CONTATO.bairro} · {CONTATO.cidade}</p>
      <dl>{CONTATO.horarios.map((h) => (<><dt>{h.dias}</dt><dd>{h.horas}</dd></>))}</dl>
      <a class="botao" href={linkWhatsApp(WHATSAPP, CONTATO.mensagemPedido)} target="_blank" rel="noopener">Pedir pelo WhatsApp</a>
    </div>
    <figure class="mapa-rua">
      <svg viewBox="0 0 480 360" role="img" aria-label={`Mapa ilustrativo: a LS Brew fica na ${CONTATO.endereco}, esquina com a Rua do Coado, no ${CONTATO.bairro}, perto da Praça do Grão e da orla`}>
        <defs><clipPath id="mapa-recorte"><rect width="480" height="360" rx="14" /></clipPath></defs>
        <g clip-path="url(#mapa-recorte)" font-family="Outfit Variable, system-ui, sans-serif">
          <rect width="480" height="360" fill="var(--bege)" />
          <!-- Malha inclinada, como o traçado de Fortaleza -->
          <g transform="rotate(-11 240 190)">
            <rect x="-120" y="-160" width="720" height="215" fill="var(--mapa-mar)" />
            <path d="M-120 42 q30 -8 60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0" fill="none" stroke="var(--creme)" stroke-width="2" opacity=".7" />
            <path d="M-120 22 q30 -8 60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0" fill="none" stroke="var(--creme)" stroke-width="2" opacity=".5" />
            <rect x="262" y="222" width="116" height="72" rx="6" fill="var(--mapa-praca)" />
            <g fill="#B9B18E"><circle cx="290" cy="244" r="9" /><circle cx="320" cy="262" r="10" /><circle cx="354" cy="240" r="8" /></g>
            <g stroke="var(--creme)" fill="none" stroke-linecap="square">
              <path d="M-120 72 H600" stroke-width="22" />
              <path d="M-120 210 H600" stroke-width="16" />
              <path d="M-120 304 H600" stroke-width="12" />
              <path d="M110 72 V520" stroke-width="12" />
              <path d="M250 72 V520" stroke-width="16" />
              <path d="M390 72 V520" stroke-width="12" />
            </g>
            <g fill="var(--mapa-rotulo)" font-size="12">
              <text x="40" y="34">Mar</text>
              <text x="140" y="76">Av. Beira-Mar</text>
              <text x="20" y="214">Rua da Torra</text>
              <text x="40" y="308">Rua do Forno</text>
              <text transform="translate(254 222) rotate(90)" x="0" y="0">Rua do Coado</text>
              <text x="276" y="286">Praça do Grão</text>
            </g>
          </g>
          <!-- Pino da LS Brew: a ponta fica na esquina da Rua da Torra com a Rua do Coado (250,210 na malha, girada para 254,208) -->
          <g transform="translate(254 194)">
            <path d="M0 -44 C 22 -44 30 -24 22 -10 C 14 4 0 14 0 14 C 0 14 -14 4 -22 -10 C -30 -24 -22 -44 0 -44 Z" fill="var(--cafe)" />
            <g transform="translate(0 -22) scale(0.2) translate(-132 -112)"><path d={metades[0]} fill="var(--caramelo)" /><path d={metades[1]} fill="var(--caramelo)" /></g>
            <rect x="30" y="-40" width="74" height="24" rx="12" fill="var(--cafe)" />
            <text x="67" y="-24" text-anchor="middle" font-size="12" font-weight="500" fill="var(--creme)">LS Brew</text>
          </g>
          <!-- Rosa dos ventos -->
          <g transform="translate(446 324)" fill="var(--mapa-rotulo)"><path d="M0 -14 L5 2 L0 -2 L-5 2 Z" /><text y="14" text-anchor="middle" font-size="11">N</text></g>
        </g>
      </svg>
      <figcaption>Mapa ilustrativo. O endereço é fictício.</figcaption>
    </figure>
  </div>
</section>
