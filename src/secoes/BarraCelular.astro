---
// Barra de baixo do celular, na área do polegar: "Seções" abre a gaveta e "Pedir pelo WhatsApp" é a ação principal.
// A gaveta é um <dialog> modal: prende o foco, fecha no Esc/voltar e deixa o resto da página inerte.
import { WHATSAPP } from "../config.js";
import { CONTATO } from "../dados/contato.js";
import { linkWhatsApp } from "../dominio/whatsapp.js";
import { SECOES } from "./links.js";
---
<div class="barra">
  <button type="button" class="barra-secoes precisa-js" aria-haspopup="dialog" aria-controls="gaveta">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    Seções
  </button>
  <!-- Sem JavaScript a gaveta não abre: "Seções" vira um link para a lista de seções do rodapé. -->
  <a class="barra-secoes so-sem-js" href="#secoes-rodape">Seções</a>
  <a class="botao barra-pedir" href={linkWhatsApp(WHATSAPP, CONTATO.mensagemPedido)} target="_blank" rel="noopener">Pedir pelo WhatsApp</a>
</div>
<dialog id="gaveta" class="gaveta" aria-labelledby="gaveta-titulo">
  <div class="gaveta-cabeca">
    <p id="gaveta-titulo">Seções</p>
    <button type="button" class="gaveta-fechar" aria-label="Fechar">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    </button>
  </div>
  <nav aria-label="Seções do site">
    <ul>{SECOES.map(([h, t]) => <li><a href={h}>{t}</a></li>)}</ul>
  </nav>
</dialog>
<script>
  import { iniciarGaveta } from "../cliente/gaveta.js";
  iniciarGaveta(document.getElementById("gaveta"), document.querySelector(".barra-secoes"));
</script>
<style>
  .barra {
    position: fixed; inset: auto 0 0; z-index: 60; display: flex; gap: 8px; align-items: center;
    padding: 8px max(12px, env(safe-area-inset-right, 0px)) calc(8px + var(--seguro-baixo)) max(12px, env(safe-area-inset-left, 0px));
    background: var(--cafe); color: var(--creme); box-shadow: 0 -6px 24px rgba(26, 18, 13, .18);
  }
  .barra-secoes {
    text-decoration: none;
    display: inline-flex; align-items: center; gap: 8px; min-height: var(--toque); padding: 0 18px; border-radius: 999px;
    border: 0; box-shadow: inset 0 0 0 1.5px rgba(246, 240, 231, .55); background: transparent; color: var(--creme);
    font: 500 16px var(--texto); cursor: pointer;
  }
  .barra-secoes:active { transform: scale(.97); }
  .barra-pedir { flex: 1; }
  .barra :focus-visible { outline-color: var(--creme); }
  @media (min-width: 861px) and (pointer: fine) { .barra { display: none; } }

  .gaveta {
    width: 100%; max-width: 100%; max-height: 85svh; margin: auto 0 0; padding: 0 0 var(--seguro-baixo); border: 0;
    border-radius: 20px 20px 0 0; background: var(--creme); color: var(--cafe);
    transition: transform .32s var(--ease-drawer), display .32s allow-discrete, overlay .32s allow-discrete;
    transform: translateY(100%);
  }
  .gaveta[open] { transform: none; }
  @starting-style { .gaveta[open] { transform: translateY(100%); } }
  .gaveta::backdrop { background: rgba(26, 18, 13, 0); transition: background-color .32s var(--ease-out), display .32s allow-discrete, overlay .32s allow-discrete; }
  .gaveta[open]::backdrop { background: rgba(26, 18, 13, .5); }
  @starting-style { .gaveta[open]::backdrop { background: rgba(26, 18, 13, 0); } }
  .gaveta-cabeca { display: flex; align-items: center; justify-content: space-between; padding: 8px 8px 0 24px; }
  .gaveta-cabeca p { margin: 0; font: 600 22px var(--titulo); }
  .gaveta-fechar { display: grid; place-items: center; width: var(--toque); height: var(--toque); border: 0; border-radius: 999px; background: transparent; color: var(--cafe); cursor: pointer; }
  .gaveta ul { list-style: none; margin: 0; padding: 4px 12px 16px; }
  .gaveta a { display: flex; align-items: center; min-height: 52px; padding: 0 12px; border-radius: 12px; font-size: 18px; text-decoration: none; }
  .gaveta a::after { content: "→"; margin-left: auto; color: var(--caramelo-texto); }
  .gaveta a:active { background: var(--bege); }
  /* Com a gaveta aberta, arrastar o fundo escuro não rola a página (nem a abertura) por trás. */
  :global(html:has(dialog[open])) { overflow: hidden; }
</style>
