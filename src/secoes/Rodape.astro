---
import Logo from "../ui/Logo.astro";
import { CONTATO } from "../dados/contato.js";
---
<footer class="rodape">
  <div class="miolo rodape-grade">
    <div>
      <Logo variante="escuro" />
      <p style="margin-top:16px">Café especial de sombra, torra lenta e preparo na hora.</p>
      <p>{CONTATO.instagram}</p>
    </div>
    <div>
      <div class="precisa-js">
        <h3 style="color: var(--creme)">Lotes novos no seu e-mail</h3>
        <slot />
      </div>
      <noscript><p>Para receber os lotes novos, siga a gente no {CONTATO.instagram}.</p></noscript>
    </div>
  </div>
  <small class="miolo">Projeto de portfólio LS · cafeteria, endereço e telefone fictícios. Fotos e vídeo: Pexels. Letras Fraunces e Outfit (SIL OFL).</small>
</footer>
