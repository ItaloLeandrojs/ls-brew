---
import { METODOS } from "../dados/preparo.js";
---
<!-- Sem JavaScript: as fichas dos três métodos ficam à mostra; só o cronômetro some. -->
<p class="sub">O cronômetro precisa de JavaScript ligado. As fichas de cada método estão abaixo.</p>
<div class="preparo-fichas">
  {METODOS.map((m) => (
    <section>
      <h3>{m.nome}</h3>
      <dl class="ficha">
        <dt>Proporção</dt><dd>{m.proporcao}</dd>
        <dt>Dose</dt><dd>{m.dose}</dd>
        <dt>Água</dt><dd>{m.agua}</dd>
        <dt>Moagem</dt><dd>{m.moagem}</dd>
        <dt>Temperatura</dt><dd>{m.temperatura}</dd>
      </dl>
    </section>
  ))}
</div>
