---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/outfit";
import "../styles/tokens.css";
import "../styles/base.css";
import { INDEXAR } from "../config.js";
const { titulo = "LS Brew · café especial", descricao = "Café especial da Serra de Baturité, torra lenta e preparo na hora. Projeto de portfólio LS com dados fictícios." } = Astro.props;
const base = import.meta.env.BASE_URL;
const url = new URL(Astro.url.pathname, Astro.site).href;
const imagem = new URL(base + "og.jpg", Astro.site).href;
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{titulo}</title>
  <meta name="description" content={descricao}>
  {!INDEXAR && <meta name="robots" content="noindex">}
  <link rel="canonical" href={url}>
  <link rel="icon" href={base + "favicon.svg"} type="image/svg+xml">
  <link rel="apple-touch-icon" href={base + "apple-touch-icon.png"}>
  <meta name="theme-color" content="#F6F0E7">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="pt_BR">
  <meta property="og:title" content={titulo}>
  <meta property="og:description" content={descricao}>
  <meta property="og:url" content={url}>
  <meta property="og:site_name" content="LS Brew">
  <meta property="og:image" content={imagem}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
