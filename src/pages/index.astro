---
import Base from "../layouts/Base.astro";
import Topo from "../secoes/Topo.astro";
import Origem from "../secoes/Origem.astro";
import Cardapio from "../secoes/Cardapio.jsx";
import Preparo from "../secoes/Preparo.jsx";
import Quiz from "../secoes/Quiz.jsx";
import Clube from "../secoes/Clube.astro";
import Newsletter from "../secoes/Newsletter.jsx";
import Visite from "../secoes/Visite.astro";
import Rodape from "../secoes/Rodape.astro";
import "../styles/secoes.css";
---
<Base>
  <script is:inline>document.documentElement.classList.add("js");</script>
  <Topo />
  <main id="conteudo">
    <Origem />
    <section id="cardapio" class="secao" style="background: var(--creme)">
      <div class="miolo">
        <p class="rotulo">Cardápio</p>
        <h2>Do coado ao pão de queijo</h2>
        <Cardapio client:visible />
      </div>
    </section>
    <section id="preparo" class="secao" style="background: var(--bege)">
      <div class="miolo">
        <p class="rotulo" style="color: var(--texto-2)">Guia de preparo</p>
        <h2>Faça em casa, com o nosso tempo</h2>
        <div class="precisa-js"><Preparo client:visible /></div>
        <noscript><p class="sub">O cronômetro precisa de JavaScript ligado. As receitas estão no cardápio acima.</p></noscript>
      </div>
    </section>
    <section id="quiz" class="secao">
      <div class="miolo">
        <p class="rotulo">Quiz</p>
        <h2>Qual café combina com você?</h2>
        <div class="precisa-js"><Quiz client:visible /></div>
        <noscript><p class="sub">O quiz precisa de JavaScript ligado.</p></noscript>
      </div>
    </section>
    <Clube />
    <Visite />
  </main>
  <Rodape><Newsletter client:visible /></Rodape>
  <script>
    import { iniciarRevelar } from "../ui/revelar.js";
    iniciarRevelar();
  </script>
</Base>
