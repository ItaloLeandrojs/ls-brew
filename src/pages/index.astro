---
import Base from "../layouts/Base.astro";
import Topo from "../secoes/Topo.astro";
import Abertura from "../secoes/Abertura.astro";
import Origem from "../secoes/Origem.astro";
import Cardapio from "../secoes/Cardapio.astro";
import Preparo from "../secoes/Preparo.astro";
import Quiz from "../secoes/Quiz.astro";
import Clube from "../secoes/Clube.astro";
import Galeria from "../secoes/Galeria.astro";
import Visite from "../secoes/Visite.astro";
import Rodape from "../secoes/Rodape.astro";
import BarraCelular from "../secoes/BarraCelular.astro";
import "../styles/revelar.css";
---
<Base>
  <Topo />
  <main id="conteudo">
    <Abertura />
    <Origem />
    <Cardapio />
    <Preparo />
    <Quiz />
    <Clube />
    <Galeria />
    <Visite />
  </main>
  <Rodape />
  <BarraCelular />
  <script>
    import { iniciarRevelar } from "../cliente/revelar.js";
    iniciarRevelar();
  </script>
</Base>
