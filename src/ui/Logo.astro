---
// Logo LS Brew em linha (SVG da pasta ls-brew-marca). variante: claro (fundo claro) | escuro.
import claro from "../assets/logo/ls-brew-fundo-claro.svg?raw";
import escuro from "../assets/logo/ls-brew-fundo-escuro.svg?raw";
import simClaro from "../assets/logo/ls-brew-simbolo-fundo-claro.svg?raw";
import simEscuro from "../assets/logo/ls-brew-simbolo-fundo-escuro.svg?raw";
const { variante = "claro", comNome = true, classe = "" } = Astro.props;
const svg = comNome ? (variante === "escuro" ? escuro : claro) : (variante === "escuro" ? simEscuro : simClaro);
const acessivel = svg.replace("<svg ", '<svg role="img" aria-label="LS Brew" ');
---
<span class={`logo ${classe}`.trim()} set:html={acessivel} />
<style>
  .logo { display: inline-block; line-height: 0; }
  .logo :global(svg) { height: 100%; width: auto; }
</style>
