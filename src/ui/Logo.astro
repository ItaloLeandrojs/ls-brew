---
// Logo LS Brew em linha (SVG da pasta ls-brew-marca). variante: claro (fundo claro) | escuro.
// Como <img>: cada SVG tem ~20 KB; em linha ele se repetia no HTML (topo do celular, do computador e rodapé).
// Como arquivo, baixa uma vez e fica no cache.
import claro from "../assets/logo/ls-brew-fundo-claro.svg?url";
import escuro from "../assets/logo/ls-brew-fundo-escuro.svg?url";
const { variante = "claro", classe = "" } = Astro.props;
---
<img class={`logo ${classe}`.trim()} src={variante === "escuro" ? escuro : claro} alt="LS Brew" width="766" height="236" />
<style>
  .logo { width: auto; }
</style>
