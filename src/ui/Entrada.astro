---
import simbolo from "../assets/logo/ls-brew-simbolo-fundo-claro.svg?raw";
const metades = [...simbolo.matchAll(/<path d="(M[^"]+Z)" fill="#[0-9A-Fa-f]{6}"\/>/g)].map((m) => m[1]);
if (metades.length !== 2) throw new Error(`Entrada: esperava 2 metades do grão no símbolo, achei ${metades.length}`);
---
<div id="entrada" aria-hidden="true">
  <svg viewBox="17 5 220 220">
    <path class="m0" d={metades[0]} fill="var(--grao)" />
    <path class="m1" d={metades[1]} fill="var(--grao)" />
  </svg>
</div>
<noscript><style is:inline>#entrada{display:none}</style></noscript>
<script is:inline>
  // Decide antes de pintar, para não piscar: quem não deve ver a entrada nem chega a vê-la.
  (function () {
    var q = new URLSearchParams(location.search).get("abertura") === "1";
    var visto = false; try { visto = sessionStorage.getItem("ls-brew:entrada") === "1"; } catch (e) {}
    var mostrar = q || (!visto && !navigator.webdriver);
    if (!mostrar) document.documentElement.classList.add("sem-entrada");
  })();
</script>
<script>
  import { iniciarEntrada } from "./entrada-cliente.js";
  iniciarEntrada();
</script>
<style is:global>
  #entrada { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; background: var(--creme); transition: opacity .5s var(--curva); animation: entrada-some .4s 8s forwards; }
  /* Rede de segurança só com CSS: se o script falhar, a entrada some sozinha. */
  @keyframes entrada-some { to { opacity: 0; visibility: hidden; pointer-events: none; } }
  #entrada svg { width: 120px; height: 120px; }
  #entrada .m0 { animation: m0 1.1s var(--curva) both; }
  #entrada .m1 { animation: m1 1.1s var(--curva) both; }
  @keyframes m0 { from { transform: translate(-28px, 18px); opacity: 0; } }
  @keyframes m1 { from { transform: translate(28px, -18px); opacity: 0; } }
  #entrada.saindo { opacity: 0; pointer-events: none; }
  .sem-entrada #entrada { display: none; }
  /* Reduzir movimento anula todas as animações; a rede de segurança precisa continuar valendo (id vence o *). */
  @media (prefers-reduced-motion: reduce) { #entrada { animation: entrada-some .01s 8s forwards !important; } }
</style>
